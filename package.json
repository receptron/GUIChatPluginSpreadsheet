{
  "name": "@gui-chat-plugin/spreadsheet",
  "version": "4.3.0",
  "description": "Spreadsheet plugin for GUIChat",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src demo",
    "format": "prettier --write \"{src,demo,tests}/**/*.{ts,tsx,vue,json,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"{src,demo,tests}/**/*.{ts,tsx,vue,json,css}\" \"*.{ts,js,json}\"",
    "quality": "scoria",
    "test": "vitest run",
    "test:engine": "tsx --test \"tests/**/test_*.ts\"",
    "test:watch": "vitest",
    "test:fixtures": "tsx tests/engine/run-all-fixtures.ts",
    "test:calculator": "tsx tests/engine/run-calculator-tests.ts",
    "test:evaluator": "tsx tests/engine/run-evaluator-tests.ts",
    "test:functions": "tsx tests/engine/test-functions.ts",
    "test:all": "vitest run && yarn run test:engine && tsx tests/engine/run-all-fixtures.ts",
    "test:scripts": "tsx tests/engine/run-formatter-tests.ts && tsx tests/engine/run-lowercase-test.ts && tsx tests/engine/run-pv-analysis-test.ts && tsx tests/engine/run-pv-analysis-complete-test.ts && tsx tests/engine/run-recalc-test.ts",
    "test:suites": "yarn run test:all && yarn run test:calculator && yarn run test:evaluator && yarn run test:functions && yarn run test:scripts",
    "test:coverage": "c8 yarn run test:suites"
  },
  "peerDependencies": {
    "gui-chat-protocol": "^2.3.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "gui-chat-protocol": "^2.3.0",
    "prettier": "^3.9.10",
    "scoria": "^0.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "keywords": [
    "guichat",
    "plugin",
    "spreadsheet",
    "excel"
  ],
  "license": "MIT"
}
